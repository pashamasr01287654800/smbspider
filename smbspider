#!/bin/bash

# ================= SMBSpider - SMART SMB TOOL =================
# Colors
RED='\033[0;31m'
GRN='\033[0;32m'
YEL='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
RESET='\033[0m'
BOLD='\033[1m'

# ================= GLOBALS =================
TARGET=""
USER=""
PASS=""
DOMAIN=""
HASH=""
NULL_SESSION=0
OUTPUT=""
SMB_PORT="445"

# Operations
OPERATION="none"
SHARE_NAME=""
SHARE_PATH=""
DOWNLOAD_PATH=""
DOWNLOAD_LOCAL=""
UPLOAD_SOURCE=""
UPLOAD_DEST_PATH=""
DO_RESOLVE=0

# ================= FUNCTIONS =================

