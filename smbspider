# ================= UTILITIES =================
clean_path() {
    local path="$1"
    echo "$path" | sed 's#^/*##; s#/*$##; s#//*#/#g'
}

clean_share() {
    local share="$1"
    echo "$share" | sed 's#/##g'
}

format_smb_url() {
    local ip="$1"
    local share="$2"
    local path="$3"
    
    if [ -n "$path" ]; then
        echo "smb://$ip:$SMB_PORT/$share/$path"
    elif [ -n "$share" ]; then
        echo "smb://$ip:$SMB_PORT/$share/"
    else
        echo "smb://$ip:$SMB_PORT/"
    fi
}

print_error() { echo -e "${RED}[-] $1${RESET}"; }
print_success() { echo -e "${GRN}[+] $1${RESET}"; }
print_info() { echo -e "${YEL}[*] $1${RESET}"; }
print_warning() { echo -e "${YEL}[!] $1${RESET}"; }

# ================= AUTHENTICATION - SUPPORTS ALL HASH FORMATS =================
build_auth() {
    if [ "$NULL_SESSION" = "1" ] && [ -n "$USER" -o -n "$HASH" -o -n "$PASS" ]; then
        NULL_SESSION=0
    fi
    
    if [ -n "$HASH" ] && [ -n "$USER" ]; then
        local nt_hash=""
        local lm_hash=""
        
        if [[ "$HASH" == *":"* ]] && [[ "$HASH" != ":"* ]]; then
            lm_hash=$(echo "$HASH" | cut -d':' -f1)
            nt_hash=$(echo "$HASH" | cut -d':' -f2-)
        elif [[ "$HASH" == ":"* ]]; then
            lm_hash=""
            nt_hash=$(echo "$HASH" | cut -d':' -f2-)
        else
            lm_hash=""
            nt_hash="$HASH"
        fi
        
        nt_hash=$(echo "$nt_hash" | tr -d ' ')
        
        if [ -n "$DOMAIN" ]; then
            echo "-p $SMB_PORT -U \"$DOMAIN\\\\$USER\" --pw-nt-hash -p $nt_hash"
        else
            echo "-p $SMB_PORT -U \"$USER\" --pw-nt-hash -p $nt_hash"
        fi
        return
    fi
    
    if [ -n "$USER" ] && [ -n "$PASS" ]; then
        if [ -n "$DOMAIN" ]; then
            echo "-p $SMB_PORT -U \"$DOMAIN\\\\$USER%$PASS\""
        else
            echo "-p $SMB_PORT -U \"$USER%$PASS\""
        fi
        return
    fi
    
    if [ -n "$USER" ]; then
        if [ -n "$DOMAIN" ]; then
            echo "-p $SMB_PORT -U \"$DOMAIN\\\\$USER\""
        else
            echo "-p $SMB_PORT -U \"$USER\""
        fi
        return
    fi
    
    if [ "$NULL_SESSION" = "1" ]; then
        echo "-p $SMB_PORT -N"
    else
        echo "-p $SMB_PORT -N"
    fi
}

# ================= CHECK REMOTE FILE/FOLDER EXISTS =================
check_remote_file() {
    local share="$1"
    local file="$2"
    local auth=$(build_auth)
    
    local dir=$(dirname "$file")
    local filename=$(basename "$file")
    
    if [ "$dir" = "." ]; then
        dir=""
    fi
    
    local list_cmd="ls"
    if [ -n "$dir" ]; then
        list_cmd="cd \"$dir\"; ls"
    fi
    
    local output=$(eval smbclient "//$TARGET/$share" $auth -c "$list_cmd" 2>&1)
    local exit_code=$?
    
    if echo "$output" | grep -qi "NT_STATUS_LOGON_FAILURE"; then
        return 5
    elif echo "$output" | grep -qi "NT_STATUS_ACCESS_DENIED"; then
        return 2
    elif echo "$output" | grep -qi "NT_STATUS_BAD_NETWORK_NAME"; then
        return 3
    elif echo "$output" | grep -qi "NT_STATUS_OBJECT_NAME_NOT_FOUND"; then
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_NO_SUCH_FILE"; then
        return 1
    fi
    
    if [ $exit_code -ne 0 ]; then
        if echo "$output" | grep -qi "NT_STATUS_OBJECT_NAME_NOT_FOUND"; then
            return 1
        elif echo "$output" | grep -qi "NT_STATUS_NOT_FOUND"; then
            return 1
        else
            return 1
        fi
    fi
    
    if echo "$output" | grep -qi "^$filename[[:space:]]"; then
        if echo "$output" | grep -qi "^$filename[[:space:]].*D"; then
            return 4
        else
            return 0
        fi
    else
        return 1
    fi
}

# ================= CHECK IF PATH IS A DIRECTORY =================
check_is_directory() {
    local share="$1"
    local path="$2"
    local auth=$(build_auth)
    
    if [ -z "$path" ]; then
        return 0
    fi
    
    local output=$(eval smbclient "//$TARGET/$share" $auth -c "cd \"$path\"; ls" 2>&1)
    local exit_code=$?
    
    if echo "$output" | grep -qi "NT_STATUS_NOT_A_DIRECTORY"; then
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_OBJECT_NAME_NOT_FOUND"; then
        return 2
    elif echo "$output" | grep -qi "NT_STATUS_ACCESS_DENIED"; then
        return 3
    elif echo "$output" | grep -qi "NT_STATUS_LOGON_FAILURE"; then
        return 5
    elif echo "$output" | grep -qi "NT_STATUS_BAD_NETWORK_NAME"; then
        return 3
    fi
    
    if [ $exit_code -eq 0 ] && ! echo "$output" | grep -qi "NT_STATUS"; then
        return 0
    fi
    
    return 1
}

# ================= CORE FUNCTIONS =================

check_port() {
    print_info "Checking SMB on $TARGET:$SMB_PORT..."
    if timeout 2 bash -c "echo >/dev/tcp/$TARGET/$SMB_PORT" 2>/dev/null; then
        print_success "Port $SMB_PORT is open"
        echo -e "  $(format_smb_url "$TARGET")"
        return 0
    else
        print_error "Port $SMB_PORT is closed"
        return 1
    fi
}

resolve_hostname() {
    print_info "Resolving hostname..."
    if command -v nmblookup &>/dev/null; then
        local name=$(nmblookup -A "$TARGET" 2>/dev/null | grep -E '<00>' | grep -v 'GROUP' | head -1 | awk '{print $1}')
        if [ -n "$name" ]; then
            print_success "NetBIOS name: $name"
            echo -e "  $(format_smb_url "$name")"
        fi
    fi
}

list_shares() {
    print_info "Fetching shares from $TARGET..."
    local auth=$(build_auth)
    local cmd="smbclient -L \"//$TARGET\" $auth -p $SMB_PORT"
    
    local output=$(eval $cmd 2>&1)
    
    if echo "$output" | grep -q "NT_STATUS_LOGON_FAILURE"; then
        print_error "Login failed"
        return 1
    fi
    
    echo -e "\n${BOLD}${CYAN}Available Shares:${RESET}\n"
    local count=0
    local in_share=0
    
    while IFS= read -r line; do
        if [[ "$line" == *"Sharename"* ]] && [[ "$line" == *"Type"* ]]; then
            in_share=1
            continue
        fi
        
        if [ $in_share -eq 1 ] && [ -n "$line" ]; then
            [[ "$line" == *"--"* ]] && continue
            
            if [[ "$line" == *"Disk"* ]]; then
                share=$(echo "$line" | awk '{print $1}')
                if [ -n "$share" ] && [ "$share" != "Disk" ]; then
                    echo -e "  ${GRN}📁 $share${RESET}"
                    ((count++))
                fi
            fi
        fi
        
        [[ "$line" == *"blocks"* ]] && in_share=0
    done <<< "$output"
    
    [ $count -eq 0 ] && echo "  No shares found"
}

list_content() {
    local input="$SHARE_NAME"
    local share=""
    local path=""
    
    # Parse share and path
    if [[ "$input" == *"/"* ]]; then
        share=$(echo "$input" | cut -d'/' -f1)
        path=$(echo "$input" | cut -d'/' -f2-)
    else
        share="$input"
        path=""
    fi
    
    share=$(clean_share "$share")
    path=$(clean_path "$path")
    
    # Display share header
    echo -e "${BOLD}${CYAN}Share: ${GRN}$share${RESET}"
    
    if [ -n "$path" ]; then
        print_info "Contents of $share/$path:"
    else
        print_info "Contents of $share:"
    fi
    echo
    
    local auth=$(build_auth)
    local cmd="smbclient \"//$TARGET/$share\" $auth -p $SMB_PORT"
    
    if [ -n "$path" ]; then
        cmd="$cmd -c \"cd \\\"$path\\\"; ls\""
    else
        cmd="$cmd -c \"ls\""
    fi
    
    local output=$(eval $cmd 2>&1)
    
    if echo "$output" | grep -q "NT_STATUS_ACCESS_DENIED"; then
        print_error "Access denied to $share"
        return 1
    fi
    
    if echo "$output" | grep -q "NT_STATUS_BAD_NETWORK_NAME"; then
        print_error "Share '$share' not found"
        return 1
    fi
    
    if echo "$output" | grep -q "NT_STATUS_OBJECT_NAME_NOT_FOUND"; then
        print_error "Path '$path' not found in share '$share'"
        return 1
    fi
    
    if echo "$output" | grep -q "NT_STATUS_LOGON_FAILURE"; then
        print_error "Login failed"
        return 1
    fi
    
    # Display contents - starting from share, showing full path
    local files=0; local dirs=0
    local display_path=""
    
    while IFS= read -r line; do
        [[ "$line" =~ blocks ]] && continue
        [[ -z "$line" ]] && continue
        
        name=$(echo "$line" | awk '{print $1}')
        [[ "$name" == "." || "$name" == ".." ]] && continue
        
        # Build the full display path starting from share
        if [ -n "$path" ]; then
            display_path="$share/$path/$name"
        else
            display_path="$share/$name"
        fi
        
        # Clean up double slashes
        display_path=$(echo "$display_path" | sed 's#//*#/#g')
        
        if [[ "$line" == *" D "* ]]; then
            echo -e "  ${CYAN}📂 $display_path/${RESET}"
            ((dirs++))
        else
            size=$(echo "$line" | awk '{print $3}')
            
            if [[ "$size" =~ ^[0-9]+$ ]]; then
                if command -v numfmt &>/dev/null; then
                    size_hr=$(numfmt --to=iec "$size")
                else
                    if [ $size -gt 1048576 ]; then
                        size_hr="$((size/1048576))MB"
                    elif [ $size -gt 1024 ]; then
                        size_hr="$((size/1024))KB"
                    else
                        size_hr="${size}B"
                    fi
                fi
                echo -e "  ${GRN}📄 $display_path${RESET} ${YEL}($size_hr)${RESET}"
            else
                echo -e "  ${GRN}📄 $display_path${RESET}"
            fi
            ((files++))
        fi
    done <<< "$output"
    
    echo -e "\n${CYAN}  📊 $dirs directories, $files files${RESET}"
}

# ================= DOWNLOAD FUNCTION =================
download_file() {
    local path="$DOWNLOAD_PATH"
    local local_name="$DOWNLOAD_LOCAL"
    
    # Remove leading slash if exists
    path=$(echo "$path" | sed 's#^/##')
    
    # Extract share and file path
    local share=$(echo "$path" | cut -d'/' -f1)
    local remote_file=$(echo "$path" | cut -d'/' -f2-)
    
    # Get just the filename (last part of the path)
    local remote_filename=$(basename "$remote_file")
    
    # Determine local path for saving
    local local_path
    if [ -n "$local_name" ]; then
        # User specified a custom local filename
        local_path="./$local_name"
        print_info "Downloading: $share/$remote_file"
        print_info "Save as: $local_name"
    else
        # Use just the remote filename, save in current directory
        local_path="./$remote_filename"
        print_info "Downloading: $share/$remote_file"
        print_info "Save to: $remote_filename"
    fi

    # Check if destination is a directory
    if [ -d "$local_path" ]; then
        print_error "Destination '$local_path' exists and is a directory. Cannot overwrite with file."
        return 1
    fi

    # Check if file already exists locally
    if [ -f "$local_path" ]; then
        while true; do
            echo -n -e "${YEL}File '$local_path' exists locally. Overwrite? (y/n): ${RESET}"
            read -r response
            
            if [[ "$response" =~ ^[Yy]$ ]]; then
                rm -f "$local_path"
                break
            elif [[ "$response" =~ ^[Nn]$ ]]; then
                print_warning "Download cancelled"
                return 1
            else
                print_error "Please enter 'y' or 'n'"
            fi
        done
    fi
    
    local auth=$(build_auth)
    
    # Create a temporary file for output to avoid partial downloads
    local temp_file="${local_path}.tmp"
    
    # Ensure any old temp file is removed
    rm -f "$temp_file"
    
    # Download using smbclient - get remote file, save to temp
    local smbclient_cmd="smbclient \"//$TARGET/$share\" $auth -p $SMB_PORT -c \"get \\\"$remote_file\\\" \\\"$temp_file\\\"\" 2>&1"
    
    # Execute the command and capture output and exit code
    local output
    output=$(eval "$smbclient_cmd")
    local result=$?
    
    # Check for specific errors in the output regardless of exit code
    if echo "$output" | grep -qi "NT_STATUS_ACCESS_DENIED"; then
        print_error "Download failed: Access Denied. You don't have permission to read this file."
        rm -f "$temp_file" 2>/dev/null
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_OBJECT_NAME_NOT_FOUND"; then
        print_error "Download failed: File not found. The path '$remote_file' does not exist in share '$share'."
        rm -f "$temp_file" 2>/dev/null
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_BAD_NETWORK_NAME"; then
        print_error "Download failed: Share '$share' not found on the target."
        rm -f "$temp_file" 2>/dev/null
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_LOGON_FAILURE"; then
        print_error "Download failed: Login failed. Check your username, password, or hash."
        rm -f "$temp_file" 2>/dev/null
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_FILE_IS_A_DIRECTORY"; then
        print_error "Download failed: The specified path is a directory, not a file. Use -s to list contents."
        rm -f "$temp_file" 2>/dev/null
        return 1
    elif echo "$output" | grep -qi "NT_STATUS_OBJECT_PATH_NOT_FOUND"; then
        print_error "Download failed: One or more parent directories in the path '$remote_file' do not exist."
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    
    # If we got this far, check if the command succeeded and the temp file exists and has content
    if [ $result -eq 0 ] && [ -f "$temp_file" ] && [ -s "$temp_file" ]; then
        mv "$temp_file" "$local_path"
        local size=$(du -h "$local_path" 2>/dev/null | cut -f1)
        print_success "Download completed: $(basename "$local_path") ($size)"
        return 0
    else
        # Generic failure
        rm -f "$temp_file" 2>/dev/null
        print_error "Download failed for an unknown reason."
        return 1
    fi
}

# ================= UPLOAD FUNCTION =================
upload_file() {
    local src_file="$UPLOAD_SOURCE"
    local dest_path="$UPLOAD_DEST_PATH"
    
    # Check if source file exists locally
    if [ ! -f "$src_file" ]; then
        print_error "Local file not found: $src_file"
        return 1
    fi
    
    # Clean destination path - remove leading slash but KEEP trailing slash info
    local original_dest="$dest_path"
    dest_path=$(echo "$dest_path" | sed 's#^/*##')
    
    # Check if destination ends with slash (even after cleaning)
    local ends_with_slash=0
    if [[ "$original_dest" == */ ]] || [[ "$dest_path" == */ ]]; then
        ends_with_slash=1
        # Remove trailing slash for processing
        dest_path=$(echo "$dest_path" | sed 's#/*$##')
    fi
    
    # Extract share and destination path
    local share=$(echo "$dest_path" | cut -d'/' -f1)
    local dest_remainder=$(echo "$dest_path" | cut -d'/' -f2-)
    
    # Get source filename
    local src_filename=$(basename "$src_file")
    
    # Determine the final destination filename and path
    local final_filename=""
    local final_dir=""
    local display_dest=""
    
    # If destination ends with slash, it's definitely a directory
    if [ $ends_with_slash -eq 1 ]; then
        final_dir="$dest_remainder"
        final_filename="$src_filename"
        if [ -n "$dest_remainder" ]; then
            display_dest="$share/$dest_remainder/$src_filename"
        else
            display_dest="$share/$src_filename"
        fi
        print_info "Uploading: $src_filename → $display_dest"
    else
        # No trailing slash - need to determine if the last part is part of a file path or directory
        if [ -z "$dest_remainder" ]; then
            final_dir=""
            final_filename="$src_filename"
            display_dest="$share/$src_filename"
            print_info "Uploading: $src_filename → $display_dest"
        else
            # Split the remainder into directory path and possible filename
            local last_segment=$(basename "$dest_remainder")
            local path_before_last=$(dirname "$dest_remainder")
            
            if [ "$path_before_last" = "." ]; then
                path_before_last=""
            fi
            
            # Check if the last segment exists and what it is
            check_remote_file "$share" "$dest_remainder"
            local check_result=$?
            
            if [ $check_result -eq 0 ]; then
                # Last segment exists as a FILE
                final_dir="$path_before_last"
                final_filename="$last_segment"
                display_dest="$share/$dest_remainder"
                print_info "Uploading: $src_filename → $display_dest (overwrite)"
            elif [ $check_result -eq 4 ]; then
                # Last segment exists as a DIRECTORY
                final_dir="$dest_remainder"
                final_filename="$src_filename"
                display_dest="$share/$dest_remainder/$src_filename"
                print_info "Uploading: $src_filename → $display_dest"
            else
                # Last segment doesn't exist - treat as filename
                final_dir="$path_before_last"
                final_filename="$last_segment"
                display_dest="$share/$dest_remainder"
                print_info "Uploading: $src_filename → $display_dest"
            fi
        fi
    fi
    
    # Clean up final_dir
    final_dir=$(echo "$final_dir" | sed 's#^/*##; s#/*$##')
    
    # Build the full remote path for checking
    if [ -n "$final_dir" ]; then
        remote_file_for_check="$final_dir/$final_filename"
    else
        remote_file_for_check="$final_filename"
    fi
    
    # Check if file already exists remotely
    check_remote_file "$share" "$remote_file_for_check"
    local remote_check=$?
    
    if [ $remote_check -eq 0 ]; then
        # File exists
        while true; do
            echo -n -e "${YEL}File '$final_filename' exists remotely. Overwrite? (y/n): ${RESET}"
            read -r response
            
            if [[ "$response" =~ ^[Yy]$ ]]; then
                break
            elif [[ "$response" =~ ^[Nn]$ ]]; then
                print_warning "Upload cancelled"
                return 1
            else
                print_error "Please enter 'y' or 'n'"
            fi
        done
    fi
    
    # Proceed with upload
    local auth=$(build_auth)
    
    # Build smbclient command for upload
    local smbclient_cmd=""
    if [ -n "$final_dir" ]; then
        # Ensure directory exists (try to create if it doesn't)
        check_is_directory "$share" "$final_dir"
        local dir_exists=$?
        
        if [ $dir_exists -eq 2 ]; then
            # Directory doesn't exist, try to create it
            print_info "Creating directory structure: $share/$final_dir"
            
            # Create directory structure recursively
            local current_path=""
            IFS='/' read -ra dir_parts <<< "$final_dir"
            for part in "${dir_parts[@]}"; do
                if [ -n "$current_path" ]; then
                    current_path="$current_path/$part"
                else
                    current_path="$part"
                fi
                
                check_is_directory "$share" "$current_path"
                if [ $? -eq 2 ]; then
                    local mkdir_cmd="mkdir \"$current_path\""
                    eval smbclient "//$TARGET/$share" $auth -p $SMB_PORT -c "$mkdir_cmd" >/dev/null 2>&1
                fi
            done
        fi
        
        smbclient_cmd="smbclient \"//$TARGET/$share\" $auth -p $SMB_PORT -c \"cd \\\"$final_dir\\\"; put \\\"$src_file\\\" \\\"$final_filename\\\"\""
    else
        smbclient_cmd="smbclient \"//$TARGET/$share\" $auth -p $SMB_PORT -c \"put \\\"$src_file\\\" \\\"$final_filename\\\"\""
    fi
    
    local output=$(eval "$smbclient_cmd" 2>&1)
    local result=$?
    
    if [ $result -eq 0 ]; then
        local size=$(du -h "$src_file" 2>/dev/null | cut -f1)
        print_success "Upload completed: $display_dest ($size)"
        return 0
    else
        print_error "Upload failed"
        if echo "$output" | grep -q "NT_STATUS_ACCESS_DENIED"; then
            echo "  → No write permission"
        elif echo "$output" | grep -q "NT_STATUS_BAD_NETWORK_NAME"; then
            echo "  → Share '$share' not found"
        elif echo "$output" | grep -q "NT_STATUS_LOGON_FAILURE"; then
            echo "  → Login failed"
        elif echo "$output" | grep -q "NT_STATUS_OBJECT_NAME_COLLISION"; then
            echo "  → Object name collision"
        elif echo "$output" | grep -q "NT_STATUS_NOT_A_DIRECTORY"; then
            echo "  → Path exists but is not a directory"
        fi
        return 1
    fi
}

# ================= INTERACTIVE MODE =================
interactive_mode() {
    local auth=$(build_auth)
    
    # If we have a share name, use it directly
    if [ -n "$SHARE_NAME" ]; then
        local share=$(clean_share "$SHARE_NAME")
        echo -e "${BOLD}${CYAN}Share: ${GRN}$share${RESET}"
        print_info "Type 'help' for commands, 'exit' to quit"
        echo
        
        local cmd="smbclient \"//$TARGET/$share\" $auth -p $SMB_PORT"
        eval $cmd
        return
    fi
    
    # No share specified, show menu
    print_info "Fetching available shares..."
    
    # Get shares list
    local output=$(eval smbclient -L "//$TARGET" $auth -p $SMB_PORT 2>&1)
    
    # Check for errors
    if echo "$output" | grep -q "NT_STATUS_LOGON_FAILURE"; then
        print_error "Login failed"
        return 1
    fi
    
    # Parse shares
    local shares=()
    local in_share=0
    
    while IFS= read -r line; do
        if [[ "$line" == *"Sharename"* ]] && [[ "$line" == *"Type"* ]]; then
            in_share=1
            continue
        fi
        
        if [ $in_share -eq 1 ] && [ -n "$line" ]; then
            [[ "$line" == *"--"* ]] && continue
            if [[ "$line" == *"Disk"* ]]; then
                share=$(echo "$line" | awk '{print $1}')
                [ -n "$share" ] && [ "$share" != "Disk" ] && shares+=("$share")
            fi
        fi
        
        [[ "$line" == *"blocks"* ]] && in_share=0
    done <<< "$output"
    
    if [ ${#shares[@]} -eq 0 ]; then
        print_error "No shares found"
        return 1
    fi
    
    # Display menu
    echo -e "\n${CYAN}Available shares:${RESET}"
    for i in "${!shares[@]}"; do
        echo -e "  ${GRN}$((i+1))) 📁 ${shares[$i]}${RESET}"
    done
    echo -e "  ${RED}$(( ${#shares[@]} + 1 ))) Exit${RESET}"
    echo
    
    # Get user choice
    while true; do
        echo -n "Select share (1-$(( ${#shares[@]} + 1 ))): "
        read -r choice
        
        if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
            print_error "Please enter a number"
            continue
        fi
        
        if [ "$choice" -lt 1 ] || [ "$choice" -gt $(( ${#shares[@]} + 1 )) ]; then
            print_error "Invalid choice"
            continue
        fi
        
        break
    done
    
    # Exit option
    if [ "$choice" -eq $(( ${#shares[@]} + 1 )) ]; then
        print_info "Exiting interactive mode"
        return 0
    fi
    
    # Valid share selected
    local selected="${shares[$((choice-1))]}"
    echo -e "\n${GRN}Share: $selected${RESET}"
    echo -e "${YEL}Type 'help' for commands, 'exit' to quit${RESET}\n"
    
    local cmd="smbclient \"//$TARGET/$selected\" $auth -p $SMB_PORT"
    eval $cmd
}

# ================= SMART ARGUMENT PARSING =================
parse_arguments() {
    local args=("$@")
    
    if [ ${#args[@]} -lt 1 ]; then
        print_banner
        print_help
        exit 0
    fi
    
    TARGET="${args[0]}"
    
    # Check for help
    if [ "$TARGET" = "-h" ] || [ "$TARGET" = "--help" ] || [ "$TARGET" = "help" ]; then
        print_banner
        print_help
        exit 0
    fi
    
    local i=1
    local TEMP_LIST=0
    local TEMP_SHARE=""
    local INTERACTIVE_FOUND=0
    local UPLOAD_FOUND=0
    
    while [ $i -lt ${#args[@]} ]; do
        case "${args[$i]}" in
            -n) NULL_SESSION=1 ;;
            -r) DO_RESOLVE=1 ;;
            -o) 
                OUTPUT="${args[$((i+1))]}"
                if [ -f "$OUTPUT" ]; then
                    rm -f "$OUTPUT"
                fi
                i=$((i+1))
                ;;
            -port) 
                SMB_PORT="${args[$((i+1))]}"
                if ! [[ "$SMB_PORT" =~ ^[0-9]+$ ]] || [ "$SMB_PORT" -lt 1 ] || [ "$SMB_PORT" -gt 65535 ]; then
                    print_error "Invalid port number: $SMB_PORT"
                    exit 1
                fi
                i=$((i+1))
                ;;
            -H) HASH="${args[$((i+1))]}"; i=$((i+1)) ;;
            -u) USER="${args[$((i+1))]}"; i=$((i+1)) ;;
            -p) PASS="${args[$((i+1))]}"; i=$((i+1)) ;;
            -d) DOMAIN="${args[$((i+1))]}"; i=$((i+1)) ;;
            -h|--help|help) print_banner; print_help; exit 0 ;;
            
            -s) 
                TEMP_LIST=1
                if [ $((i+1)) -lt ${#args[@]} ] && [[ ! "${args[$((i+1))]}" =~ ^- ]]; then
                    TEMP_SHARE="${args[$((i+1))]}"
                    TEMP_SHARE=$(echo "$TEMP_SHARE" | sed 's#^/##')
                    i=$((i+1))
                fi
                ;;
            -i) 
                INTERACTIVE_FOUND=1
                if [ $((i+1)) -lt ${#args[@]} ] && [[ ! "${args[$((i+1))]}" =~ ^- ]]; then
                    SHARE_NAME="${args[$((i+1))]}"
                    SHARE_NAME=$(echo "$SHARE_NAME" | sed 's#^/##')
                    i=$((i+1))
                fi
                DOWNLOAD_PATH=""
                UPLOAD_FOUND=0
                ;;
            -get) 
                OPERATION="download"
                DOWNLOAD_PATH="${args[$((i+1))]}"
                DOWNLOAD_PATH=$(echo "$DOWNLOAD_PATH" | sed 's#^/##')
                i=$((i+1))
                
                # Check for optional local filename
                if [ $((i+1)) -lt ${#args[@]} ] && [[ ! "${args[$((i+1))]}" =~ ^- ]]; then
                    DOWNLOAD_LOCAL="${args[$((i+1))]}"
                    i=$((i+1))
                fi
                
                TEMP_LIST=0
                INTERACTIVE_FOUND=0
                UPLOAD_FOUND=0
                ;;
            -up) 
                UPLOAD_FOUND=1
                OPERATION="upload"
                # Get source file
                if [ $((i+1)) -lt ${#args[@]} ] && [[ ! "${args[$((i+1))]}" =~ ^- ]]; then
                    UPLOAD_SOURCE="${args[$((i+1))]}"
                    i=$((i+1))
                else
                    print_error "-up requires source file and destination path"
                    exit 1
                fi
                # Get destination path
                if [ $((i+1)) -lt ${#args[@]} ] && [[ ! "${args[$((i+1))]}" =~ ^- ]]; then
                    UPLOAD_DEST_PATH="${args[$((i+1))]}"
                    i=$((i+1))
                else
                    print_error "-up requires destination path"
                    exit 1
                fi
                TEMP_LIST=0
                INTERACTIVE_FOUND=0
                ;;
            *) print_error "Unknown option: ${args[$i]}"; exit 1 ;;
        esac
        i=$((i+1))
    done
    
    if [ "$INTERACTIVE_FOUND" = "1" ]; then
        OPERATION="interactive"
        if [ -z "$SHARE_NAME" ] && [ -n "$TEMP_SHARE" ]; then
            SHARE_NAME="$TEMP_SHARE"
        fi
    elif [ "$TEMP_LIST" = "1" ] && [ "$OPERATION" = "none" ] && [ "$UPLOAD_FOUND" = "0" ]; then
        OPERATION="list"
        SHARE_NAME="$TEMP_SHARE"
    fi
    
    if [ -n "$HASH" ] && [ -n "$PASS" ]; then
        PASS=""
    fi
    
    if [ -n "$HASH" ] && [ -z "$USER" ]; then
        print_error "-H requires -u (username)"
        exit 1
    fi
    
    if [ -n "$PASS" ] && [ -z "$USER" ]; then
        print_error "-p requires -u (username)"
        exit 1
    fi
}

# ================= MAIN =================
main() {
    parse_arguments "$@"
    
    if [ -n "$OUTPUT" ]; then
        > "$OUTPUT"
        exec > >(tee "$OUTPUT") 2>&1
    fi
    
    print_banner
    
    echo -e "${BOLD}Target:${RESET} $TARGET"
    [ -n "$USER" ] && echo -e "${BOLD}User:${RESET} $USER"
    [ -n "$DOMAIN" ] && echo -e "${BOLD}Domain:${RESET} $DOMAIN"
    if [ -n "$HASH" ]; then
        if [[ "$HASH" == *":"* ]]; then
            echo -e "${BOLD}Hash:${RESET} (LM:NT format)"
        else
            echo -e "${BOLD}Hash:${RESET} (NT format)"
        fi
    fi
    [ -n "$PASS" ] && echo -e "${BOLD}Password:${RESET} ($PASS)"
    
    if [ "$NULL_SESSION" = "1" ] && [ -z "$USER" ] && [ -z "$HASH" ] && [ -z "$PASS" ]; then
        echo -e "${BOLD}Mode:${RESET} Null Session"
    fi
    
    [ -n "$OUTPUT" ] && echo -e "${BOLD}Output:${RESET} $OUTPUT"
    echo
    
    check_port || exit 1
    [ "$DO_RESOLVE" = "1" ] && resolve_hostname
    
    case "$OPERATION" in
        "interactive")
            interactive_mode
            ;;
        "download")
            download_file
            ;;
        "upload")
            upload_file
            ;;
        "list")
            if [ -n "$SHARE_NAME" ]; then
                list_content
            else
                list_shares
            fi
            ;;
        *)
            echo -e "\n${YEL}Use -s to list shares or -i for interactive mode${RESET}"
            ;;
    esac
}

main "$@"
exit 0
